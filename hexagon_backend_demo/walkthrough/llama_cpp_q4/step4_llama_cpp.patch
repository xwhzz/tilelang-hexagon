diff --git a/ggml/src/ggml-hexagon/CMakeLists.txt b/ggml/src/ggml-hexagon/CMakeLists.txt
index 845b922b..501c3d11 100644
--- a/ggml/src/ggml-hexagon/CMakeLists.txt
+++ b/ggml/src/ggml-hexagon/CMakeLists.txt
@@ -26,0 +27,10 @@ set(GGML_HEXAGON_HTP_CERT  "$ENV{HEXAGON_HTP_CERT}" CACHE PATH "ggml-hexagon: en
+set(GGML_HEXAGON_TILELANG_SOURCE_DIR "$ENV{TILELANG_SOURCE_DIR}" CACHE PATH
+    "TileLang source tree used by generated Hexagon kernels")
+option(GGML_HEXAGON_TILELANG_WALKTHROUGH
+    "Build the one-shape TileLang Q4 walkthrough" OFF)
+
+if (GGML_HEXAGON_TILELANG_WALKTHROUGH AND
+    NOT IS_DIRECTORY "${GGML_HEXAGON_TILELANG_SOURCE_DIR}/src/tl_templates/hexagon")
+    message(FATAL_ERROR
+        "Set GGML_HEXAGON_TILELANG_SOURCE_DIR to the TileLang source tree")
+endif()
@@ -72,0 +83,2 @@ function(build_htp_skel V)
+            -DTILELANG_SOURCE_DIR:PATH=${GGML_HEXAGON_TILELANG_SOURCE_DIR}
+            -DTILELANG_WALKTHROUGH:BOOL=${GGML_HEXAGON_TILELANG_WALKTHROUGH}
diff --git a/ggml/src/ggml-hexagon/htp/CMakeLists.txt b/ggml/src/ggml-hexagon/htp/CMakeLists.txt
index 9f9471f6..06bb0f71 100644
--- a/ggml/src/ggml-hexagon/htp/CMakeLists.txt
+++ b/ggml/src/ggml-hexagon/htp/CMakeLists.txt
@@ -14,0 +15,13 @@ include_directories(
+set(TILELANG_WALKTHROUGH_SOURCES)
