diff --git a/ggml/src/ggml-hexagon/CMakeLists.txt b/ggml/src/ggml-hexagon/CMakeLists.txt
index 845b922b..c98208eb 100644
--- a/ggml/src/ggml-hexagon/CMakeLists.txt
+++ b/ggml/src/ggml-hexagon/CMakeLists.txt
@@ -26,0 +27,10 @@ set(GGML_HEXAGON_HTP_CERT  "$ENV{HEXAGON_HTP_CERT}" CACHE PATH "ggml-hexagon: en
+set(GGML_HEXAGON_TILELANG_SOURCE_DIR "$ENV{TILELANG_SOURCE_DIR}" CACHE PATH
+    "TileLang source tree used by generated Hexagon kernels")
+option(GGML_HEXAGON_TILELANG_Q4_HMX
+    "ggml-hexagon: enable the experimental TileLang Q4 HMX dispatch" OFF)
+
+if (GGML_HEXAGON_TILELANG_Q4_HMX AND
+    NOT IS_DIRECTORY "${GGML_HEXAGON_TILELANG_SOURCE_DIR}/src/tl_templates/hexagon")
+    message(FATAL_ERROR
+        "Set GGML_HEXAGON_TILELANG_SOURCE_DIR (or TILELANG_SOURCE_DIR) to the TileLang source tree")
+endif()
@@ -72,0 +83,2 @@ function(build_htp_skel V)
+            -DTILELANG_SOURCE_DIR:PATH=${GGML_HEXAGON_TILELANG_SOURCE_DIR}
+            -DTILELANG_Q4_HMX:BOOL=${GGML_HEXAGON_TILELANG_Q4_HMX}
diff --git a/ggml/src/ggml-hexagon/htp/CMakeLists.txt b/ggml/src/ggml-hexagon/htp/CMakeLists.txt
index 9f9471f6..00f094c2 100644
--- a/ggml/src/ggml-hexagon/htp/CMakeLists.txt
+++ b/ggml/src/ggml-hexagon/htp/CMakeLists.txt
@@ -14,0 +15,18 @@ include_directories(
+set(TILELANG_Q4_SOURCES)
+if (TILELANG_Q4_HMX)
+    if (NOT IS_DIRECTORY "${TILELANG_SOURCE_DIR}/src/tl_templates/hexagon")
+        message(FATAL_ERROR "TILELANG_SOURCE_DIR does not contain TileLang Hexagon templates")
+    endif()
+    include_directories(
+        ${TILELANG_SOURCE_DIR}/src
+        ${TILELANG_SOURCE_DIR}/src/tl_templates/hexagon)
+    list(APPEND TILELANG_Q4_SOURCES
+        tl_ggml_matmul.cc
+        kernel_qmatmul_hmx_atoms_32x128x2048.cc
+        kernel_qmatmul_hmx_atoms_32x128x8192.cc
+        kernel_qmatmul_hmx_atoms_32x512x2048.cc
+        kernel_qmatmul_hmx_atoms_32x512x8192.cc
+        kernel_qmatmul_hmx_staged_32x256x2048.cc
+        kernel_qmatmul_hmx_staged_32x256x8192.cc)
+endif()
+
@@ -43,0 +62 @@ add_library(${HTP_LIB} SHARED
+    ${TILELANG_Q4_SOURCES}
@@ -49,0 +69,17 @@ target_compile_definitions(${HTP_LIB} PRIVATE
+if (TILELANG_Q4_HMX)
+    # hmx.h contains reusable inline atoms not all used by these units.
+    set_source_files_properties(tl_ggml_matmul.cc
+        PROPERTIES COMPILE_OPTIONS "-Wno-unused-function")
+    # Native -O2 codegen stays bounded; whole-skel LTO materializes the large
+    # generated kernels again during the final link.
+    set_source_files_properties(
+        kernel_qmatmul_hmx_atoms_32x128x2048.cc
+        kernel_qmatmul_hmx_atoms_32x128x8192.cc
+        kernel_qmatmul_hmx_atoms_32x512x2048.cc
+        kernel_qmatmul_hmx_atoms_32x512x8192.cc
+        kernel_qmatmul_hmx_staged_32x256x2048.cc
+        kernel_qmatmul_hmx_staged_32x256x8192.cc
+        PROPERTIES COMPILE_OPTIONS "-Wno-unused-function;-fno-lto")
+    target_compile_definitions(${HTP_LIB} PRIVATE TL_Q4_HMX_ENABLED=1)
+endif()
+
diff --git a/ggml/src/ggml-hexagon/htp/matmul-ops.c b/ggml/src/ggml-hexagon/htp/matmul-ops.c
index 79c292dc..ab43d920 100644
--- a/ggml/src/ggml-hexagon/htp/matmul-ops.c
+++ b/ggml/src/ggml-hexagon/htp/matmul-ops.c
@@ -23,0 +24,30 @@
+#ifdef TL_Q4_HMX_ENABLED
+#include <tl_templates/hexagon/tl_embed.h>
+
+static int tl_dma_push_1d(
+        void * queue, void * dst, const void * src, uint32_t bytes) {
+    return dma_queue_push(
+        (dma_queue *) queue, dma_make_ptr(dst, src), bytes, bytes, bytes, 1) ? 0 : -1;
+}
+
+static int tl_dma_push_2d(
+        void * queue, void * dst, const void * src,
+        uint32_t dst_stride, uint32_t src_stride,
+        uint32_t width, uint32_t height) {
+    return dma_queue_push(
+        (dma_queue *) queue, dma_make_ptr(dst, src),
+        dst_stride, src_stride, width, height) ? 0 : -1;
+}
+
+static void * tl_dma_pop(void * queue) {
+    return dma_queue_pop((dma_queue *) queue).dst;
+}
+
+static int tl_parallel_run(
+        void * pool, tl_parallel_task task, void * data,
+        unsigned int workers) {
+    return worker_pool_run_func(
+        (worker_pool_context_t) pool, (worker_callback_t) task,
+        data, workers) == 0 ? 0 : -1;
+}
+#endif
@@ -2162,0 +2193,29 @@ static int hmx_mm_2d_f32(struct htp_context *ctx,
+#ifdef TL_Q4_HMX_ENABLED
+    // Offer the whole op to TileLang before the stock HMX implementation.
+    // A non-matching shape or failed run falls through without changing ABI.
+    {
+        struct tl_op_ctx octx = {0};
+        octx.vtcm_base   = ctx->vtcm_base;
+        octx.vtcm_size   = ctx->vtcm_size;
+        octx.vtcm_rctx   = ctx->vtcm_rctx;
+        octx.dma.queue   = ctx->dma[0];
+        octx.dma.push_1d = tl_dma_push_1d;
+        octx.dma.push_2d = tl_dma_push_2d;
+        octx.dma.pop     = tl_dma_pop;
+        octx.parallel.pool        = ctx->worker_pool;
+        octx.parallel.run         = tl_parallel_run;
+        octx.parallel.max_workers = n_threads;
+        octx.kind        = TL_OP_MATMUL;
+        octx.weight_type = weight_type;
+        octx.has_bias    = (src2 != NULL);
+        octx.dst         = dst;
+        octx.act         = activation;
+        octx.weight      = weight;
+        octx.m           = m;
+        octx.k           = k;
+        octx.n           = n;
+        octx.act_stride  = act_stride;
+        octx.dst_stride  = dst_stride;
+        if (tl_dispatch(&octx) == 0) return 0;
+    }
+#endif
