 static void tiled_vec_dot_q8_0_32x1(const uint32_t n, float * restrict s, const void * restrict vx, const void * restrict vy, uint32_t valid_rows, const float * restrict sz) {
+    // TileLang embedding seam: ggml still owns activation quantization, the
+    // per-worker DMA queue, and VTCM.  Offer only the ready 32xK dot atom; a
+    // declined dispatch falls through to the byte-identical stock kernel.
+    {
+        struct tl_op_ctx octx = {0};
+        octx.kind        = TL_OP_QGEMV_DOT;
+        octx.weight_type = HTP_TYPE_Q8_0;
+        octx.dst         = s;
+        octx.weight      = (const uint8_t *) vx;
+        octx.k           = (int) n;
+        octx.n           = 32;
+        octx.tiled_act   = (const uint8_t *) vy;
+        octx.bias        = sz;
+        octx.valid_rows  = (int) valid_rows;
+        if (tl_dispatch(&octx) == 0) {
+            return;
+        }
+    }
+
     const uint8_t * restrict tile_ptr = vx;
     const uint8_t * restrict y_q = vy;
 
